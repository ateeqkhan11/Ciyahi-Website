# Optional — not required to deploy the site.
# Copy to .env.local only if you enable these features later.

# Web3Forms public access key (also lock the key to ciyahi.com in the Web3Forms dashboard)
# VITE_WEB3FORMS_ACCESS_KEY=

# Plausible Analytics (optional). Only needed if you later want visitor maps/countries.
# Create a site at https://plausible.io, then set:
# VITE_PLAUSIBLE_DOMAIN=ciyahi.com
# and re-enable <Analytics /> in src/App.jsx
